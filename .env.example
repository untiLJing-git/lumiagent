# ═══════════════════════════════════════
# LumiAgent Configuration
# Copy this file to .env and fill values
# ═══════════════════════════════════════

# ── LLM Providers ──
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Embedding model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Platform: Feishu ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ── Platform: DingTalk ──
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ── Platform: WeChat (企业微信) ──
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=
WECHAT_TOKEN=
WECHAT_AES_KEY=

# ── Web Platform ──
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_SECRET_KEY=change-me-in-production

# ── RAG ──
RAG_VECTOR_STORE=chroma
RAG_CHROMA_PATH=./data/chroma
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# ── Memory ──
MEMORY_DB_PATH=./data/memory.db
MEMORY_SHORT_TERM_MAX_TURNS=20

# ── Tools ──
TOOL_BASH_ENABLED=true
TOOL_BASH_TIMEOUT=30
