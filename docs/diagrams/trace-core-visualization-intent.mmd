flowchart TB
    subgraph Capture[Capture layer]
        Strategy[CaptureStrategy\nMCP / hooks / SDK / proxy / import]
    end

    subgraph TraceCore[Trace Core data]
        Run[AgentRun\nstatus / timing / metadata]
        SpanTree[Span Tree]
        Events[Events]
        Artifacts[Artifacts]
        Evaluations[Evaluations]
        Diagnoses[Diagnoses]
        Evidence[Evidence span links]
        Annotation[Annotation\nfuture human feedback]
        RunLink[Run linking\nparent_run_id / triggered_by_span_id]
    end

    subgraph ViewModels[View models - Phase 5]
        SummaryVM[Run summary view model]
        TimelineVM[Timeline view model]
        TreeVM[Span tree view model]
        DetailVM[Span detail view model]
        DiagnosisVM[Diagnosis summary view model]
        DiffVM[Trace diff view model]
        ExperimentVM[Experiment comparison view model]
    end

    subgraph Surfaces[Visualization surfaces]
        CliViewer[CLI Viewer\nPhase 2b / 3]
        WebUI[Web UI\nPhase 7\ntimeline / tree / detail / diagnosis]
        DiffView[Trace diff view\nPhase 5]
        ExperimentView[Experiment comparison\nPhase 5]
    end

    subgraph Principle[Extension principle]
        Metadata[metadata / artifacts / adapter conventions]
        Promote[Promote to Core only when\ngeneric, stable, repeated]
        DataFirst[Data models before UI\nstable data then friendly UI]
    end

    Strategy --> Run

    Run --> SummaryVM
    Run --> TimelineVM
    SpanTree --> TimelineVM
    SpanTree --> TreeVM
    SpanTree --> DetailVM
    Events --> DetailVM
    Artifacts --> DetailVM
    Evaluations --> DiagnosisVM
    Diagnoses --> DiagnosisVM
    Evidence --> DetailVM
    RunLink --> ExperimentVM
    Annotation --> DiagnosisVM

    SummaryVM --> CliViewer
    TimelineVM --> CliViewer
    TreeVM --> CliViewer
    DiagnosisVM --> CliViewer
    SummaryVM --> WebUI
    TimelineVM --> WebUI
    TreeVM --> WebUI
    DetailVM --> WebUI
    DiagnosisVM --> WebUI
    DiffVM --> DiffView
    ExperimentVM --> ExperimentView

    Metadata --> ViewModels
    ViewModels --> Promote
    Promote --> DataFirst

